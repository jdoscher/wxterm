# wxterm kiosk settings. Copy to kiosk/kiosk.conf (gitignored) and edit; kiosk/setup.sh, mode.sh, capture.sh,
# scripts/deploy.sh and scripts/wxctl.sh all read it. Every value here is optional; the defaults are shown.

# --- Accounts and paths ---------------------------------------------------------------------------------------
# Where the code lives on the kiosk
WXTERM_DIR=/opt/wxterm
# Runtime files: saved theme/location (state.json), GIFs, screenshots, display settings
STATE_DIR=/var/lib/wxterm
# Account that autologs into tty1 and runs the display (created if missing, no password)
KIOSK_USER=wxterm
# Account that owns WXTERM_DIR and pushes updates with scripts/deploy.sh (default: the user who ran sudo setup.sh)
DEPLOY_USER=
# People who manage the kiosk, space-separated: added to the docker and kiosk groups, and given a ~/gifs shortcut
ADMIN_USERS=

# --- Data ---------------------------------------------------------------------------------------------------
# The NWS asks every API client to include a contact (email or URL) in its User-Agent
NWS_CONTACT=

# --- Hardware profile ---
# standard: laptops and mini PCs. pi: Raspberry Pi 4/5, early testing (slower animation, four locations by default)
PROFILE=standard
# Locations to run, by name from locations/order (space-separated). Blank = all of them, or for PROFILE=pi:
# "home sf london tokyo". Each location is one ~70 MB collector.
LOCATIONS=
# Seconds per radar frame and per teletype step. Blank = the profile's default (standard 0.35 / 0.15, pi 0.5 / 0.3)
RADAR_STEP=
TYPE_STEP=

# --- Display ------------------------------------------------------------------------------------------------
# Location shown at every start; other cities are a manual toggle (l). Names come from locations/order
START_LOCATION=home
# First-run theme (amber, green, white, ibm, color) and big-digit style (segment, dots, blocks); keys c and f
# change them later and the choice is saved
THEME=amber
BIGFONT=segment
# --- APRS (optional) -----------------------------------------------------------------------------------------
# Your callsign turns on APRS: stations heard on APRS-IS around home, drawn on the map (key x). Receive-only: the
# login uses passcode -1, so nothing is ever transmitted or gated. Blank = APRS off.
APRS_CALL=
# Locations that connect to APRS-IS (space-separated). Blank = the first one in locations/order (home)
APRS_LOCATIONS=
# Filter radius around each location in km (150 covers the map at 60 NM)
APRS_RANGE_KM=150
# First-run APRS layer (key x cycles it and the choice is saved): off, wx (weather stations' temperatures) or all
APRS_VIEW=all

# First-run air traffic on the map: off or on (polls the free ADS-B feeds every 2.5 s while on); key a switches it
# and the choice is saved. The radar loop is on by default; key w switches it.
AIR=off
# Laptop lid in kiosk mode: ignore (the display stays on with the lid shut) or suspend (sleep when the lid closes,
# on battery or on power, and wake when it opens; a dock or external screen keeps it awake). Applied by setup.sh.
LID=ignore
# First-run spacecraft layer: on or off. Orbits come from CelesTrak a few times a day (one download per group for the
# whole machine) and positions are worked out locally, so it adds no steady network traffic. Key o switches it.
SPACE=on
# First-run earthquake and wildfire layers: on or off (keys e and i switch them). Earthquakes from USGS and EMSC,
# wildfires from NIFC (US, with perimeters) and GDACS (large fires elsewhere); free, no keys, one download per source
# every 5 (quakes) or 15 (fires) minutes for the whole machine.
QUAKES=on
FIRES=on
# Smallest earthquake drawn for the past day (older ones from M2.5). Lower it for busy fault zones' small quakes.
QUAKE_MIN_MAG=1.5
# Burn-in guard: shuffle the layout every N minutes (0 = off)
SHUFFLE_MIN=15
# GIF frame rate for the g key
GIF_FPS=10
# Terminal font; size 13 gives 240x62 cells on a 1920x1080 screen (the layout fits any size)
FONT="DejaVu Sans Mono"
FONT_SIZE=13

# --- MCP server (lets an LLM read the weather, the kiosk's status and a screenshot; it can't change anything) ---
# yes: run it (Docker profile "mcp") on MCP_BIND:MCP_PORT, path /mcp. Connection details: scripts/wxctl.sh mcp
MCP=no
MCP_PORT=8090
# Interface to listen on: 0.0.0.0 = every LAN interface, or one address (e.g. 192.168.1.50), or 127.0.0.1 for SSH
# tunnels only. Never forward this port from the internet. Docker-published ports bypass ufw/firewalld rules.
MCP_BIND=0.0.0.0
# Bearer token clients must send. Blank: setup.sh generates one and keeps it in WXTERM_DIR/.env (mode 600)
MCP_TOKEN=

# --- Boot ---------------------------------------------------------------------------------------------------
# yes: setup.sh switches the machine to boot straight into the display (undo with: sudo kiosk/mode.sh desktop)
KIOSK_MODE=yes
