# Copy to .env (gitignored) to run the collectors outside the kiosk setup, which writes this file itself.
# Contact for the NWS API (it asks every client to identify itself):
WX_UA=wxterm/1.4 (+https://wxterm.app; you@example.com)
# APRS (optional, receive-only): your callsign, then rerun scripts/gen-compose.py. APRS_LOCATIONS defaults to the
# first location (home); APRS_RANGE_KM to 150.
#APRS_CALL=N0CALL
#APRS_LOCATIONS=home
#APRS_RANGE_KM=150
